<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}OpenCV in PHP{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" media="(prefers-color-scheme: light)">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" media="(prefers-color-scheme: dark)">
    <style>
        :root { --bg: #f6f5f1; --panel: #ffffff; --ink: #1d1d1b; --muted: #66645e; --line: #dedbd2; --accent: #b3261e; --code-bg: #ffffff; }
        @media (prefers-color-scheme: dark) {
            :root { --bg: #161614; --panel: #1f1f1c; --ink: #ecebe6; --muted: #a09e96; --line: #33322e; --accent: #ff8a80; --code-bg: #0d1117; }
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: 16px; }
        body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
        a { color: inherit; }
        header.site { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; padding: 18px 20px 12px; border-bottom: 1px solid var(--line); }
        header.site a.brand { font-weight: 700; text-decoration: none; letter-spacing: -0.01em; }
        header.site nav { margin-left: auto; font-size: 14px; color: var(--muted); }
        .layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 40px; max-width: 1280px; margin: 0 auto; padding: 0 20px; }
        nav.toc { position: sticky; top: 0; align-self: start; max-height: 100vh; overflow-y: auto; padding: 28px 0; font-size: 14px; }
        nav.toc h2 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 18px 0 6px; font-weight: 600; }
        nav.toc h2:first-child { margin-top: 0; }
        nav.toc a { display: block; padding: 3px 0; text-decoration: none; color: var(--ink); }
        nav.toc a:hover { color: var(--accent); }
        main { padding-bottom: 40px; min-width: 0; }
        h1 { font-size: clamp(26px, 4vw, 38px); line-height: 1.15; letter-spacing: -0.02em; margin: 28px 0 10px; }
        p.lead { font-size: 18px; color: var(--muted); max-width: 62ch; margin: 0 0 8px; }
        h2.group { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 44px 0 0; font-weight: 600; }
        section.example { padding: 22px 0 30px; border-bottom: 1px solid var(--line); }
        section.example h3 { font-size: 24px; letter-spacing: -0.01em; margin: 0 0 6px; }
        section.example > p { max-width: 70ch; margin: 0 0 16px; color: var(--muted); }
        .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
        figure { margin: 0; }
        figure img { max-width: 100%; max-height: 520px; height: auto; display: block; border: 1px solid var(--line); border-radius: 6px; }
        figcaption { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 6px; font-weight: 600; }
        .pieces { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
        .pieces.few { grid-template-columns: 1fr 1fr; }
        .note { border-left: 3px solid var(--accent); padding: 2px 0 2px 12px; color: var(--muted); max-width: 70ch; margin: 0 0 16px; }
        details.code { margin-top: 16px; }
        details.code summary { display: inline-block; cursor: pointer; list-style: none; background: var(--ink); color: var(--bg); padding: 8px 16px; border-radius: 6px; font-size: 14px; font-weight: 600; user-select: none; }
        details.code summary::-webkit-details-marker { display: none; }
        details.code summary:hover { background: var(--accent); color: #fff; }
        details.code[open] summary .show, details.code:not([open]) summary .hide { display: none; }
        pre { background: var(--code-bg); border: 1px solid var(--line); border-radius: 6px; overflow-x: auto; font: 13.5px/1.55 ui-monospace, "SF Mono", Menlo, Consolas, monospace; margin: 12px 0 0; }
        pre code, pre code.hljs { display: block; padding: 14px 16px; background: transparent; font: inherit; }
        pre.run { white-space: pre-wrap; overflow-wrap: anywhere; padding: 10px 16px; color: var(--muted); }
        footer.site { max-width: 1280px; margin: 0 auto; padding: 24px 20px 40px; font-size: 13px; color: var(--muted); }
        @media (max-width: 820px) {
            .layout { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 16px; }
            nav.toc { position: static; max-height: none; padding: 20px 0 0; border-bottom: 1px solid var(--line); padding-bottom: 16px; }
            .pair { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<header class="site">
    <a class="brand" href="index.html">opencv-php examples</a>
    <nav><a href="https://github.com/tacman/opencv-php">github.com/tacman/opencv-php</a></nav>
</header>
{% block body %}{% endblock %}
<footer class="site">
    Every "after" picture was made by the PHP shown with it.
    Gravestone, coin and QR photographs by Tac Tacelosky; prints from DOCUMERICA, U.S. National Archives.
</footer>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>hljs.highlightAll();</script>
</body>
</html>
